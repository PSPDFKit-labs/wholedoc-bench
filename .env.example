# Copy to .env and fill only the credentials your provider needs.
# Load explicitly: uv run --env-file .env wholedoc-bench run ...
# Never put secrets in --config JSON or commit a populated template.

# Implemented: Nutrient DWS / Data Extraction API.
NUTRIENT_API_KEY=

# Implemented: AWS Textract, through the AWS SDK's default credential chain: access keys,
# a profile (AWS_PROFILE, for example with SSO) or an IAM role, plus a region. The identity
# needs textract:AnalyzeDocument only. Uncomment what you use; a blank value still counts.
# AWS_SESSION_TOKEN is only for temporary credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_DEFAULT_REGION=

# Implemented: Azure AI Document Intelligence (prebuilt-layout). The endpoint is the
# resource's https://<resource>.cognitiveservices.azure.com/ URL and the key one of its
# two keys, both under Keys and Endpoint in the Azure portal.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Implemented: Anthropic Claude (Messages API). The key is sent to api.anthropic.com only.
ANTHROPIC_API_KEY=

# Implemented: OpenAI GPT (Responses API). The key is sent to api.openai.com only.
OPENAI_API_KEY=

# Implemented: Reducto async parse API.
REDUCTO_API_KEY=

# Implemented: Extend parse API. The workspace override is optional.
EXTEND_API_KEY=
# EXTEND_WORKSPACE_ID=

# Implemented: LlamaParse (v2 API). Sent to api.cloud.llamaindex.ai only.
LLAMA_CLOUD_API_KEY=

# Implemented: Databricks ai_parse_document (AI Functions REST API). The host is the
# workspace URL. Set a personal access token, or a service principal's OAuth client id and
# secret, not both. The volume path is a Unity Catalog volume, or a folder in one, where
# Databricks writes the rendered page images; the adapter deletes them after each document.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
DATABRICKS_VOLUME_PATH=
